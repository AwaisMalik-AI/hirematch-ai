# Copy to .env — never commit real secrets.

# --- Core ---
DATABASE_URL=postgresql+asyncpg://hirematch:hirematch@localhost:5432/hirematch
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-use-openssl-rand-hex-32-min-32-chars!!

# --- LLM (OpenAI-compatible). Leave empty to use heuristic parsers + fallback embeddings. ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Celery (defaults to REDIS_URL if unset) ---
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- App ---
DEBUG=false
RESUME_STORAGE_DIR=./data/resumes
API_V1_PREFIX=/api/v1

# --- Optional SMTP (real sends) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=recruiting@example.com
# SMTP_USE_TLS=true
